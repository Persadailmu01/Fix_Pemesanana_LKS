<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin - Persada Ilmu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    #formSection { display: none; }
  </style>
</head>
<body class="p-4">
  <div class="container">
    <!-- LOGIN SECTION -->
    <div id="loginSection">
      <h2 class="mb-4">Login Admin - Persada Ilmu</h2>
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input type="text" id="username" class="form-control">
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" id="password" class="form-control">
      </div>
      <button class="btn btn-primary" onclick="login()">Login</button>
    </div>

    <!-- FORM SECTION -->
    <div id="formSection">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Form Pemesanan LKS - Persada Ilmu</h2>
        <button class="btn btn-danger" onclick="logout()">Logout</button>
      </div>
      <form id="orderForm">
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Nama Sekolah</label>
            <input type="text" class="form-control" name="nama_sekolah" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Kecamatan</label>
            <input type="text" class="form-control" name="kecamatan" required>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label">Nama Sales</label>
            <input type="text" class="form-control" name="nama_sales">
          </div>
          <div class="col-md-4">
            <label class="form-label">Nama Pengorder</label>
            <input type="text" class="form-control" name="nama_pengorder">
          </div>
          <div class="col-md-4">
            <label class="form-label">No WA Pengorder</label>
            <input type="text" class="form-control" name="no_wa">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Tanggal Order</label>
          <input type="date" class="form-control" name="tanggal_order" required>
        </div>

        <h5>Daftar Pesanan</h5>
        <div id="daftarPesanan" class="mb-3"></div>

        <button type="submit" class="btn btn-primary">Simpan</button>
        <button type="button" class="btn btn-success" onclick="exportToExcel()">Export ke Excel</button>
      </form>
    </div>
  </div>

  <script>
    const admins = {
      "admin1": "admin123",
      "admin2": "admin123",
      "admin3": "admin123",
      "admin4": "admin123",
      "admin5": "admin123",
      "admin6": "admin123",
      "admin7": "admin123",
      "admin8": "admin123",
      "admin9": "admin123",
      "admin10": "admin123"
    };

    function login() {
      const user = document.getElementById("username").value;
      const pass = document.getElementById("password").value;
      if (admins[user] && admins[user] === pass) {
        document.getElementById("loginSection").style.display = "none";
        document.getElementById("formSection").style.display = "block";
      } else {
        alert("Login gagal. Username atau password salah.");
      }
    }

    function logout() {
      document.getElementById("formSection").style.display = "none";
      document.getElementById("loginSection").style.display = "block";
    }

    const daftarPesanan = document.getElementById('daftarPesanan');
    const pelajaran = {
      "Bahasa Indonesia": [1, 2, 3, 4, 5, 6],
      "Bahasa Inggris": [1, 2, 3, 4, 5, 6],
      "Matematika": [1, 2, 3, 4, 5, 6],
      "Pendidikan Pancasila": [1, 2, 3, 4, 5, 6],
      "Pendidikan Agama Islam": [1, 2, 3, 4, 5, 6],
      "Seni Musik": [1, 2, 3, 4, 5, 6],
      "Seni Rupa": [1, 2, 3, 4, 5, 6],
      "PJOK": [1, 2, 3, 4, 5, 6],
      "IPAS": [3, 4, 5, 6],
    };

    for (let mapel in pelajaran) {
      const div = document.createElement('div');
      div.classList.add('mb-3');
      div.innerHTML = `<strong>${mapel}</strong>`;
      pelajaran[mapel].forEach(kelas => {
        div.innerHTML += `
          <div class="input-group mb-1">
            <span class="input-group-text">Kelas ${kelas}</span>
            <input type="number" min="0" class="form-control" name="${mapel}_kelas_${kelas}" placeholder="Jumlah pesanan">
          </div>
        `;
      });
      daftarPesanan.appendChild(div);
    }

    const orderForm = document.getElementById('orderForm');
    let allOrders = [];

    orderForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(orderForm);
      const order = {};
      formData.forEach((value, key) => {
        order[key] = value;
      });
      allOrders.push(order);
      alert("Data berhasil disimpan!");
      orderForm.reset();
    });

    function exportToExcel() {
      let csvContent = "data:text/csv;charset=utf-8,";
      if (allOrders.length === 0) {
        alert("Belum ada data untuk diexport");
        return;
      }
      const headers = Object.keys(allOrders[0]);
      csvContent += headers.join(",") + "\n";

      allOrders.forEach(order => {
        const row = headers.map(header => order[header] || "");
        csvContent += row.join(",") + "\n";
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "data_pesanan_lks.csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
</html>
